      "type": "object",
      "description": "MATRIX descriptor: a width x height grid of control points (SET/GET_MATRIX at runtime). MATRIX_SIGNAL descriptors are authored inline under 'signals'; number_of_sources/base_source derive automatically.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Matrix name (object_name)."
