    "signal_source": {
      "type": "object",
      "description": "A signal source reference: which descriptor's output feeds this point in the signal chain.",
      "properties": {
        "signal_type": {
          "$ref": "#/$defs/signal_type"
        },
        "signal_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "Descriptor index of the source."
        },
        "signal_output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "Output index of the source descriptor."
        }
      },
      "required": [
        "signal_type"
      ],
      "additionalProperties": false
    },
    "signal_selector": {
      "type": "object",
      "description": "SIGNAL_SELECTOR descriptor: selects one of several signal sources (SET/GET_SIGNAL_SELECTOR at runtime).",
      "properties": {
        "name": {
          "type": "string",
          "description": "Selector name (object_name)."
        },
        "localized_description": {
          "$ref": "#/$defs/localized_string_ref"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal_source"
          },
          "minItems": 1,
          "description": "The selectable signal sources."
        },
        "current": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "#/$defs/signal_source"
            }
          ],
          "default": 0,
          "description": "Currently selected source: an index into 'sources' or an inline signal reference. Defaults to the first source."
        },
        "default": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "#/$defs/signal_source"
            }
          ],
          "description": "Default source (index into 'sources' or inline signal reference). Defaults to 'current'."
        },
        "block_latency": {
          "type": "integer",
          "default": 0
        },
        "control_latency": {
          "type": "integer",
          "default": 0
        },
