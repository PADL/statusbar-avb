          "type": "integer",
          "default": 0
        },
        "control_latency": {
          "type": "integer",
          "default": 0
        },
        "control_domain": {
          "type": "integer",
          "default": 0
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
