      "type": "object",
      "description": "CONTROL_BLOCK descriptor: groups related controls. Member controls are authored inline; their CONTROL descriptor indices and the block's number_of_controls/base_control are assigned automatically.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Block name (object_name)."
        },
        "localized_description": {
          "$ref": "#/$defs/localized_string_ref"
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          },
          "minItems": 1,
          "description": "The grouped controls."
        },
        "final_control_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "Index of the final CONTROL descriptor in the block's internal signal chain (IEEE 1722.1-2021 Table 7-62). Zero when the block has no internal signal chain."
        },
        "signal_type": {
          "$ref": "#/$defs/signal_type"
        },
        "signal_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "signal_output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        }
      },
      "required": [
        "controls"
      ],
      "additionalProperties": false
    },
