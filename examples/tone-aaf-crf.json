{
  "$schema": "../standards/ieee1722.1-schema/atdecc_aem.schema.json",
  "entity": {
    "vendor": "Statusbar",
    "model": "Tone Generator",
    "name": "Statusbar Tone Generator",
    "firmware": "${version}",
    "capabilities": [
      "AEM_SUPPORTED",
      "CLASS_A_SUPPORTED",
      "GPTP_SUPPORTED"
    ],
    "talker": {
      "capabilities": [
        "IMPLEMENTED",
        "AUDIO_SOURCE",
        "MEDIA_CLOCK_SOURCE"
      ],
      "stream_sources": 2
    },
    "listener": {
      "capabilities": [],
      "stream_sinks": 0
    },
    "configurations": [
      {
        "name": "ToneAAFCRF",
        "localized_description": { "en-US": "Tone AAF + CRF", "de-DE": "Ton AAF + CRF" },
        "streams_out": [
          {
            "name": "StreamOutputAAF",
            "symbol": "aaf_out",
            "format": { "type": "AAF", "rate": 96000, "channels": 8, "depth": 32 },
            "flags": [
              "CLASS_A"
            ],
            "localized_description": { "en-US": "AAF Audio", "de-DE": "AAF-Audio" }
          },
          {
            "name": "StreamOutputCRF",
            "symbol": "crf_out",
            "format": "0x041060010000BB80",
            "flags": [
              "CLASS_A"
            ],
            "localized_description": { "en-US": "CRF Media Clock", "de-DE": "CRF-Medientakt" }
          }
        ],
        "audio_units": [
          {
            "name": "AudioUnit",
            "localized_description": { "en-US": "Audio Unit", "de-DE": "Audioeinheit" },
            "rates": [
              96000
            ],
            "output_ports": [
              {
                "clusters": [
                  {
                    "name": "OutputCluster",
                    "localized_description": { "en-US": "Output", "de-DE": "Ausgang" },
                    "channels": 8
                  }
                ],
                "maps": [
                  { "stream": 0, "stream_ch": 0, "cluster": 0, "cluster_ch": 0 },
                  { "stream": 0, "stream_ch": 1, "cluster": 0, "cluster_ch": 1 },
                  { "stream": 0, "stream_ch": 2, "cluster": 0, "cluster_ch": 2 },
                  { "stream": 0, "stream_ch": 3, "cluster": 0, "cluster_ch": 3 },
                  { "stream": 0, "stream_ch": 4, "cluster": 0, "cluster_ch": 4 },
                  { "stream": 0, "stream_ch": 5, "cluster": 0, "cluster_ch": 5 },
                  { "stream": 0, "stream_ch": 6, "cluster": 0, "cluster_ch": 6 },
                  { "stream": 0, "stream_ch": 7, "cluster": 0, "cluster_ch": 7 }
                ]
              }
            ]
          }
        ],
        "controls": [
          {
            "name": "Identify",
            "control_type": "IDENTIFY",
            "value_type": "LINEAR_UINT8",
            "localized_description": { "en-US": "Identify", "de-DE": "Identifizieren" },
            "values": [
              { "min": 0, "max": 255, "step": 255, "default": 0, "unit": "UNITLESS" }
            ],
            "symbol": "identify"
          }
        ],
        "avb_interfaces": [
          {
            "name": "eth0",
            "flags": [
              "GPTP_SUPPORTED"
            ]
          }
        ],
        "clock_sources": [
          {
            "name": "Internal",
            "localized_description": { "en-US": "Internal", "de-DE": "Intern" },
            "type": "INTERNAL",
            "location_type": 2,
            "location_index": 0
          }
        ],
        "clock_domains": [
          {
            "name": "ClockDomain",
            "localized_description": { "en-US": "Clock Domain", "de-DE": "Taktdomäne" },
            "source": 0,
            "sources": [
              0
            ]
          }
        ]
      }
    ]
  }
}
